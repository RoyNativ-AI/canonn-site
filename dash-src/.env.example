# Clerk publishable key (public, safe to expose; pk_test_ in dev, pk_live_ in prod)
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: point the console at another API (defaults to production)
VITE_API_URL=
# Google OAuth Web client ID (public). Enables the Google Drive source in the
# Playground; consent and file transfer happen in the browser only.
VITE_GOOGLE_CLIENT_ID=
# Google API key restricted to the Picker API + canonn.ai referrers (public).
# Required for the Drive/Docs/Sheets picker.
VITE_GOOGLE_API_KEY=
# Umami (self-hosted) product analytics. Public values; unset = analytics off.
VITE_UMAMI_SCRIPT_URL=https://analytics.canonn.ai/script.js
VITE_UMAMI_WEBSITE_ID=
