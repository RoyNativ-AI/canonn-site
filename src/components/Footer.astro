---
/**
 * Canonn shared site footer. Two variants:
 *   variant="full" — 4-column footer (landing, benchmark, docs)
 *   variant="slim" — one-line footer (legal)
 * Markup is the single source of truth; styling lives in each page's
 * stylesheet (kept verbatim for pixel-match). The canonical link set is the
 * landing page's — the most complete and correct version.
 */
export interface Props {
  variant?: 'full' | 'slim';
}
const { variant = 'full' } = Astro.props;
---
{variant === 'full' && (
  <footer>
    <div class="wrap">
      <div class="fgrid">
        <div class="fbrand">
          <a class="brand" href="/" style="color:var(--dark-ink)"><img src="/assets/canon-logo.png" alt="Canonn"> Canonn</a>
          <p>The model that trusts your data. Grounded answers for enterprise, trained in, not prompted on.</p>
        </div>
        <div class="fcol">
          <div class="ft">Product</div>
          <a href="/#product">Overview</a>
          <a href="/benchmark/">Benchmark report</a>
          <a href="/#plans">Pricing</a>
          <a href="/#how">How it works</a>
          <a href="/#apps">Mobile apps</a>
        </div>
        <div class="fcol">
          <div class="ft">Developers</div>
          <a href="/#api">API</a>
          <a href="/docs/">API reference</a>
          <a href="https://api.canonn.ai" class="fmono">api.canonn.ai/v1</a>
          <a href="/dashboard/">Get an API key</a>
        </div>
        <div class="fcol">
          <div class="ft">Company</div>
          <a href="mailto:hello@canonn.ai">Contact</a>
          <a href="mailto:hello@canonn.ai?subject=Canonn%20weights%20license">Weights license</a>
          <a href="/legal/#privacy">Privacy</a>
          <a href="/legal/#terms">Terms</a>
        </div>
      </div>
      <div class="fbar">
        <div class="fmeta">© 2026 Canonn · canonn.ai</div>
        <div class="fmeta">The source of truth for enterprise AI</div>
      </div>
    </div>
  </footer>
)}

{variant === 'slim' && (
  <footer><div class="wrap">
    © 2026 Canonn · <a href="/">canonn.ai</a> · <a href="/benchmark/">Benchmarks</a>
    <a href="/docs/">API docs</a> · <a href="/dashboard/">Dashboard</a>
  </div></footer>
)}
