---
import Base from '../layouts/Base.astro';

// Public chat for a shared assistant. The share token travels in the URL
// hash (#sh_...) so it never reaches server logs or referrer headers; the
// page loads its name from /v1/share/{id} and chats through the standard
// completions endpoint with the token as the bearer. No account, no cookie.
// The rendering mirrors the console playground: markdown answers, an
// eyebrow attribution, quote-card citations, copy + timestamp on hover.

const bodyHtml = `
<main class="cwrap" id="app">
  <div class="cload" id="cload">
    <span class="cdot"></span>
  </div>
  <div class="cdead" id="cdead" hidden>
    <div class="cmark">C</div>
    <h1>This link is no longer active</h1>
    <p>Ask whoever sent it for a fresh one — or build your own grounded assistant at <a href="https://canonn.ai">canonn.ai</a>.</p>
  </div>

  <div class="cchat" id="cchat" hidden>
    <header class="chead">
      <div class="cmark small">C</div>
      <div class="chead-t">
        <div class="cname" id="cname"></div>
        <div class="cmeta" id="cmeta"></div>
      </div>
      <a class="cpow" href="https://canonn.ai" target="_blank" rel="noreferrer">Powered by Canonn</a>
    </header>

    <div class="cscroll" id="cscroll">
      <div class="chome" id="chome">
        <h2 id="chometitle"></h2>
        <p>Every answer comes from this assistant's own documents, with the passages it relied on.</p>
      </div>
      <div class="cturns" id="cturns"></div>
    </div>

    <div class="ccomposer">
      <div class="cbox">
        <textarea id="cq" rows="2" placeholder="Ask a question…" maxlength="2000"></textarea>
        <div class="crow">
          <span class="chint">Answers are grounded in the assistant's sources</span>
          <button id="csend" aria-label="Send">&#8593;</button>
        </div>
      </div>
    </div>
  </div>
</main>

<style>
  .cwrap{min-height:100dvh;display:flex;flex-direction:column;background:var(--bg);color:var(--ink)}
  /* The state blocks set display:flex, which outranks the UA's [hidden]
     rule - restore hidden's authority so only one state ever shows. */
  .cwrap [hidden]{display:none !important}
  .cload{flex:1;display:flex;align-items:center;justify-content:center}
  .cdot{width:10px;height:10px;border-radius:50%;background:var(--ink);opacity:.8;animation:cpulse 1.1s ease-in-out infinite}
  @keyframes cpulse{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(.6);opacity:.3}}
  .cdead{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px}
  .cdead h1{font-family:var(--display);font-size:26px;margin:18px 0 8px}
  .cdead p{color:var(--mute);font-size:14px;max-width:340px}
  .cdead a{text-decoration:underline}
  .cmark{width:44px;height:44px;border-radius:10px;background:var(--ink);color:var(--bg);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:20px}
  .cmark.small{width:30px;height:30px;border-radius:8px;font-size:14px}
  .cchat{flex:1;display:flex;flex-direction:column;min-height:0;height:100dvh}
  .chead{display:flex;align-items:center;gap:11px;padding:12px 18px;border-bottom:1px solid var(--line);background:color-mix(in srgb, var(--bg) 88%, transparent);backdrop-filter:blur(10px)}
  .cname{font-family:var(--display);font-weight:600;font-size:15.5px;line-height:1.2}
  .cmeta{font-family:var(--mono);font-size:10.5px;color:var(--mute);letter-spacing:.08em;text-transform:uppercase}
  .cpow{margin-left:auto;font-family:var(--mono);font-size:10.5px;color:var(--mute)}
  .cpow:hover{color:var(--ink)}
  .cscroll{flex:1;overflow-y:auto;padding:22px 18px}
  .cscroll>div{max-width:720px;margin:0 auto}
  .chome{text-align:center;padding:9vh 8px 26px}
  .chome h2{font-family:var(--display);font-size:clamp(22px,4.4vw,30px);letter-spacing:-.02em;margin-bottom:10px}
  .chome p{color:var(--mute);font-size:14px;max-width:400px;margin:0 auto}
  .cturn-u{display:flex;flex-direction:column;align-items:flex-end;margin:0 0 18px}
  .cturn-u>div:first-child{max-width:85%;background:var(--bg2);border-radius:18px;padding:9px 15px;font-size:15px;white-space:pre-wrap;word-break:break-word}
  .cturn-u .cts{margin-top:4px;padding-right:4px;font-family:var(--mono);font-size:10.5px;color:var(--mute);opacity:0;transition:opacity .2s}
  .cturn-u:hover .cts{opacity:1}
  .cturn-a{margin:0 0 26px}
  .cwho{font-family:var(--mono);font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);margin-bottom:7px}
  .ctext{font-size:15px;line-height:1.7;word-break:break-word}
  .ctext .mh1{font-weight:600;font-size:16px;padding-top:4px}
  .ctext .mh2{font-weight:600;font-size:15px;padding-top:2px}
  .ctext .mrow{display:flex;gap:9px;padding-left:4px}
  .ctext .mrow .mdot{flex:none;width:4px;height:4px;border-radius:50%;background:var(--mute);margin-top:11px}
  .ctext .msp{height:7px}
  .ctext code{font-family:var(--mono);font-size:12.5px;background:var(--bg2);border-radius:4px;padding:1px 5px}
  .ctext .cref{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--accent);vertical-align:super}
  .cerr{color:var(--lose);font-size:14px}
  .csrc{margin-top:10px}
  .csrc-h{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);cursor:pointer;background:none;border:0;padding:2px 0}
  .csrc-h:hover{color:var(--ink)}
  .csrc-h .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
  .csrc-h .chev{transition:transform .2s}
  .csrc.open .csrc-h .chev{transform:rotate(180deg)}
  .csrc-list{display:none;margin-top:8px}
  .csrc.open .csrc-list{display:block}
  .csrc-card{border:1px solid var(--line);background:color-mix(in srgb, var(--bg2) 60%, transparent);border-radius:12px;padding:11px 14px;margin-bottom:8px;cursor:pointer;transition:background .2s}
  .csrc-card:hover{background:var(--bg2)}
  .csrc-card .q{font-size:13px;line-height:1.65;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:7px}
  .csrc-card.open .q{display:block;-webkit-line-clamp:unset;overflow:visible}
  .csrc-card .t{display:flex;gap:8px;align-items:center;font-family:var(--mono);font-size:10.5px;color:var(--mute)}
  .csrc-card .t b{color:var(--accent);font-weight:600}
  .csrc-card .t .fn{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cact{display:flex;align-items:center;gap:8px;margin-top:7px;opacity:0;transition:opacity .2s}
  .cturn-a:hover .cact,.cact:focus-within{opacity:1}
  .ccopy{background:none;border:0;padding:2px 4px;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);cursor:pointer;border-radius:6px}
  .ccopy:hover{color:var(--ink)}
  .cact .cts{font-family:var(--mono);font-size:10.5px;color:var(--mute)}
  .ccomposer{padding:12px 18px calc(12px + env(safe-area-inset-bottom))}
  .cbox{max-width:720px;margin:0 auto;border:1px solid var(--line2);background:var(--panel);border-radius:20px;box-shadow:0 4px 18px rgba(31,29,26,.05)}
  .cbox:focus-within{border-color:var(--ink)}
  .cbox textarea{width:100%;border:0;outline:0;resize:none;background:transparent;font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--ink);padding:14px 18px 2px;max-height:160px}
  .crow{display:flex;align-items:center;gap:8px;padding:2px 10px 10px 18px}
  .chint{font-family:var(--mono);font-size:10.5px;color:var(--mute)}
  .crow button{margin-left:auto;width:36px;height:36px;border-radius:50%;border:0;background:var(--ink);color:var(--bg);font-size:16px;cursor:pointer;transition:opacity .2s}
  .crow button:disabled{opacity:.3;cursor:default}
  .cthinking{width:10px;height:10px;border-radius:50%;background:var(--ink);opacity:.8;animation:cpulse 1.1s ease-in-out infinite;margin-top:4px}
  @media (max-width:560px){.chint{display:none}.chome{padding-top:5vh}.cact{opacity:1}.cturn-u .cts{opacity:1}}
</style>

<script>
(function () {
  var API = 'https://api.canonn.ai/v1';
  var BT = String.fromCharCode(96); // backtick, kept out of the literal
  // On a vanity subdomain the edge injects the share id; the hash form
  // stays for plain canonn.ai/c/#token links.
  var token = window.__CANONN_SHARE__ || (location.hash || '').replace(/^#/, '');
  var el = function (id) { return document.getElementById(id); };
  var turns = [];
  var busy = false;

  function esc(s) {
    return s.replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  // The same lightweight markdown the console playground renders: bold,
  // inline code, [N] evidence markers, headings, bullets. Nothing more.
  function inline(s) {
    var out = esc(s);
    out = out.replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>');
    out = out.replace(new RegExp(BT + '([^' + BT + ']+)' + BT, 'g'), '<code>$1</code>');
    out = out.replace(/\\[(\\d{1,2})\\]/g, '<span class="cref">[$1]</span>');
    return out;
  }
  function md(text) {
    return text.split('\\n').map(function (line) {
      var h = line.match(/^(#{1,6})\\s+(.*)$/);
      if (h) return '<div class="' + (h[1].length <= 2 ? 'mh1' : 'mh2') + '">' + inline(h[2]) + '</div>';
      var b = line.match(/^\\s*(?:[-*\\u2022]|\\d+\\.)\\s+(.*)$/);
      if (b) return '<div class="mrow"><span class="mdot"></span><span>' + inline(b[1]) + '</span></div>';
      if (!line.trim()) return '<div class="msp"></div>';
      return '<div>' + inline(line) + '</div>';
    }).join('');
  }
  function fmtTime(ts) {
    return new Date(ts).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
  }

  function dead() {
    el('cload').hidden = true;
    el('cchat').hidden = true;
    el('cdead').hidden = false;
  }

  if (!/^sh_[0-9a-f]{16,}$/.test(token)) { dead(); }
  else {
    fetch(API + '/share/' + token).then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (meta) {
        el('cload').hidden = true;
        el('cchat').hidden = false;
        el('cname').textContent = meta.name;
        el('cmeta').textContent = 'Grounded assistant · ' + meta.sources + (meta.sources === 1 ? ' source' : ' sources');
        el('chometitle').textContent = meta.name;
        document.title = meta.name + ' · Canonn';
        el('cq').focus();
      })
      .catch(dead);
  }

  function render() {
    var name = el('cname').textContent || 'Assistant';
    var wrap = el('cturns');
    wrap.innerHTML = turns.map(function (t, i) {
      if (t.role === 'user') {
        return '<div class="cturn-u"><div>' + esc(t.content) + '</div>'
          + (t.ts ? '<div class="cts">' + fmtTime(t.ts) + '</div>' : '') + '</div>';
      }
      var streaming = busy && i === turns.length - 1;
      var who = esc(name)
        + (t.citations && t.citations.length
          ? ' · grounded in ' + t.citations.length + (t.citations.length === 1 ? ' passage' : ' passages')
          : '');
      var body;
      if (t.error) body = '<div class="cerr">' + esc(t.content) + '</div>';
      else if (!t.content && streaming) body = '<div class="cthinking"></div>';
      else body = '<div class="ctext">' + md(t.content) + '</div>';
      var src = '';
      if (t.citations && t.citations.length) {
        src = '<div class="csrc" id="csrc' + i + '"><button class="csrc-h" data-i="' + i + '"><span class="dot"></span>'
          + t.citations.length + (t.citations.length === 1 ? ' source' : ' sources')
          + ' <span class="chev">&#9662;</span></button><div class="csrc-list">'
          + t.citations.slice(0, 6).map(function (c, j) {
            return '<div class="csrc-card">'
              + (c.excerpt ? '<div class="q">&#8220;' + esc(c.excerpt.trim()) + '&#8221;</div>' : '')
              + '<div class="t"><b>' + (j + 1) + '</b><span class="fn">' + esc(c.filename || 'source') + '</span>'
              + '<span>&#167;' + ((c.ordinal || 0) + 1) + '</span></div></div>';
          }).join('') + '</div></div>';
      }
      var act = '';
      if (!t.error && t.content && !streaming) {
        act = '<div class="cact"><button class="ccopy" data-i="' + i + '">Copy</button>'
          + (t.ts ? '<span class="cts">' + fmtTime(t.ts) + '</span>' : '') + '</div>';
      }
      return '<div class="cturn-a"><div class="cwho">' + who + '</div>' + body + src + act + '</div>';
    }).join('');
    el('cscroll').scrollTop = el('cscroll').scrollHeight;
  }

  el('cturns').addEventListener('click', function (e) {
    var copy = e.target.closest('.ccopy');
    if (copy) {
      var t = turns[parseInt(copy.getAttribute('data-i'), 10)];
      if (t) navigator.clipboard.writeText(t.content).then(function () {
        copy.textContent = 'Copied';
        setTimeout(function () { copy.textContent = 'Copy'; }, 1500);
      });
      return;
    }
    var h = e.target.closest('.csrc-h');
    if (h) { el('csrc' + h.getAttribute('data-i')).classList.toggle('open'); return; }
    var card = e.target.closest('.csrc-card');
    if (card) card.classList.toggle('open');
  });

  function send() {
    var q = el('cq').value.trim();
    if (!q || busy) return;
    el('cq').value = '';
    el('chome').style.display = 'none';
    busy = true;
    el('csend').disabled = true;
    var history = turns.filter(function (t) { return !t.error; })
      .map(function (t) { return { role: t.role, content: t.content }; });
    var now = Date.now();
    turns.push({ role: 'user', content: q, ts: now });
    var answer = { role: 'assistant', content: '', citations: null, ts: now };
    turns.push(answer);
    render();

    fetch(API + '/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ model: 'canonn-r1', stream: true, messages: history.concat([{ role: 'user', content: q }]) }),
    }).then(function (r) {
      if (!r.ok) return r.json().then(function (b) { throw new Error(b.error || ('request failed (' + r.status + ')')); });
      var reader = r.body.getReader();
      var dec = new TextDecoder();
      var buf = '';
      function pump() {
        return reader.read().then(function (step) {
          if (step.done) return;
          buf += dec.decode(step.value, { stream: true });
          var lines = buf.split('\\n');
          buf = lines.pop() || '';
          lines.forEach(function (line) {
            if (line.indexOf('data:') !== 0) return;
            var payload = line.slice(5).trim();
            if (!payload || payload === '[DONE]') return;
            try {
              var j = JSON.parse(payload);
              if (j.canonn && j.canonn.citations) answer.citations = j.canonn.citations;
              var d = j.choices && j.choices[0] && j.choices[0].delta && j.choices[0].delta.content;
              if (d) answer.content += d;
            } catch (e) { /* keepalive */ }
          });
          render();
          return pump();
        });
      }
      return pump();
    }).catch(function (e) {
      answer.error = true;
      answer.content = e.message || 'Something went wrong - try again.';
    }).then(function () {
      busy = false;
      el('csend').disabled = false;
      render();
      el('cq').focus();
    });
  }

  el('csend').addEventListener('click', send);
  el('cq').addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });
})();
</script>
`;
---

<Base
  title="Canonn assistant"
  description="A grounded assistant that answers from its own sources, with citations."
>
  <Fragment set:html={bodyHtml} />
</Base>
